{
  "$defs": {
    "ReviewIssue": {
      "properties": {
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "category": {
          "enum": [
            "safety",
            "age_appropriateness",
            "accuracy",
            "clarity",
            "tone",
            "engagement",
            "privacy",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. S03-L02, if specific",
          "title": "Line Id"
        },
        "detail": {
          "maxLength": 400,
          "title": "Detail",
          "type": "string"
        },
        "suggestion": {
          "default": "",
          "maxLength": 400,
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "category",
        "detail"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "ReviewScores": {
      "description": "1 (poor) to 5 (excellent).",
      "properties": {
        "safety": {
          "maximum": 5,
          "minimum": 1,
          "title": "Safety",
          "type": "integer"
        },
        "age_appropriateness": {
          "maximum": 5,
          "minimum": 1,
          "title": "Age Appropriateness",
          "type": "integer"
        },
        "accuracy": {
          "maximum": 5,
          "minimum": 1,
          "title": "Accuracy",
          "type": "integer"
        },
        "clarity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Clarity",
          "type": "integer"
        },
        "story": {
          "maximum": 5,
          "minimum": 1,
          "title": "Story",
          "type": "integer"
        },
        "character_voice": {
          "maximum": 5,
          "minimum": 1,
          "title": "Character Voice",
          "type": "integer"
        }
      },
      "required": [
        "safety",
        "age_appropriateness",
        "accuracy",
        "clarity",
        "story",
        "character_voice"
      ],
      "title": "ReviewScores",
      "type": "object"
    },
    "ScriptReviewDraft": {
      "description": "LLM output.",
      "properties": {
        "scores": {
          "$ref": "#/$defs/ReviewScores"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ReviewIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "unsupported_statements": {
          "description": "Factual statements not covered by any verified claim",
          "items": {
            "$ref": "#/$defs/UnsupportedStatement"
          },
          "title": "Unsupported Statements",
          "type": "array"
        },
        "summary": {
          "maxLength": 800,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "scores",
        "summary"
      ],
      "title": "ScriptReviewDraft",
      "type": "object"
    },
    "UnsupportedStatement": {
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "text": {
          "maxLength": 400,
          "title": "Text",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "description": "critical/major: a substantive fact a kid could learn wrongly or that needs a source. minor: everyday knowledge or a restatement/exclamation directly implied by a verified claim.",
          "enum": [
            "critical",
            "major",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "text",
        "reason",
        "severity"
      ],
      "title": "UnsupportedStatement",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "review.v1",
      "default": "review.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "script_version": {
      "title": "Script Version",
      "type": "integer"
    },
    "review": {
      "$ref": "#/$defs/ScriptReviewDraft"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "blocking_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "min_score": {
      "title": "Min Score",
      "type": "integer"
    }
  },
  "required": [
    "script_version",
    "review",
    "verdict",
    "blocking_reasons",
    "min_score"
  ],
  "title": "ScriptReview",
  "type": "object"
}

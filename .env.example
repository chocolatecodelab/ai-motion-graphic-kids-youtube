# Copy to .env and fill in. Never commit .env.
# Defaults follow the free-first stack in docs/DECISIONS.md (D2).

# --- Core ---
FACTORY_ENV=development
FACTORY_TIMEZONE=Asia/Jakarta
FACTORY_CONTENT_DIR=./content
FACTORY_LIBRARY_DIR=./library
FACTORY_LOG_DIR=./logs
FACTORY_LOG_LEVEL=INFO

# --- Database (docker compose maps Postgres to host port 25432) ---
FACTORY_DATABASE_URL=postgresql+psycopg://factory:factory_dev_password@127.0.0.1:25432/factory
POSTGRES_PASSWORD=factory_dev_password

# --- Publication safety ---
# MANUAL | APPROVAL_REQUIRED | FULL_AUTOMATION
FACTORY_PUBLICATION_MODE=APPROVAL_REQUIRED
# Must be explicitly set to true by the owner after successful testing.
FACTORY_FULL_AUTOMATION_ENABLED=false

# --- LLM: Claude subscription via the Claude Code CLI (`claude -p`), no API key needed ---
FACTORY_LLM_PROVIDER=claude_cli
FACTORY_CLAUDE_CLI_PATH=claude
FACTORY_LLM_MAX_CALLS_PER_DAY=60
FACTORY_LLM_MODEL_HIGH=opus
FACTORY_LLM_MODEL_MEDIUM=sonnet
FACTORY_LLM_MODEL_LOW=haiku
FACTORY_LLM_TIMEOUT_S=900

# --- Voice: Kokoro-82M, local CPU, free ---
FACTORY_TTS_PROVIDER=kokoro
FACTORY_TTS_HERO_VOICE=af_heart
FACTORY_TTS_HERO_SPEED=1.0
FACTORY_TTS_COMPANION_VOICE=af_sky
FACTORY_TTS_COMPANION_SPEED=1.1

# --- Budgets (USD). Soft = notify, hard = pause queue. Only matter if a paid adapter is enabled. ---
FACTORY_BUDGET_EPISODE_SOFT_USD=10
FACTORY_BUDGET_EPISODE_HARD_USD=25
FACTORY_BUDGET_DAILY_SOFT_USD=15
FACTORY_BUDGET_DAILY_HARD_USD=40
FACTORY_BUDGET_MONTHLY_SOFT_USD=400
FACTORY_BUDGET_MONTHLY_HARD_USD=700

# --- YouTube (M5) ---
FACTORY_YOUTUBE_CLIENT_SECRETS_FILE=./secrets/client_secret.json
# Fernet key encrypting OAuth tokens. Generate:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Notifications ---
FACTORY_TELEGRAM_BOT_TOKEN=
FACTORY_TELEGRAM_CHAT_ID=

# --- Optional paid adapters (off by default) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
